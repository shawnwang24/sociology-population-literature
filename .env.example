# 邮件（必填，除非只做 dry-run）
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-address@gmail.com
EMAIL_TO=your-address@example.com

# Crossref 建议填写真实联系邮箱，以进入其 polite pool
CROSSREF_MAILTO=your-address@example.com

# OpenAlex 免费 API key：用于补摘要、主题与开放获取链接
OPENALEX_API_KEY=

# 可选：开启中文 AI 摘要时使用
LLM_API_KEY=
LLM_MODEL=

